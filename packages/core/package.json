{
  "name": "@locklune/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform-agnostic core for Locklune: domain types, adaptive cycle prediction, and the crypto envelope (PIN-derived key wrapping).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "@noble/hashes": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.9"
  }
}
