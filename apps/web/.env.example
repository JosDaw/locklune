# Brevo transactional email - powers the /api/contact form.
# Copy to .env.local and fill in. Never commit real values.

# API key from your Brevo account (under Settings, SMTP & API, API Keys).
BREVO_API_KEY=

# A sender address verified in your Brevo account. Defaults to support@locklune.app.
BREVO_SENDER_EMAIL=

# Where contact messages are delivered. Defaults to support@locklune.app.
CONTACT_TO_EMAIL=
