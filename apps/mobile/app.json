{
  "expo": {
    "name": "Locklune",
    "slug": "locklune",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "locklune",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000022",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.locklune",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.locklune",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#040E25",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000022",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "ios": {
            "image": "./assets/images/splash.png",
            "imageWidth": 320
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8AA2FF"
        }
      ],
      "expo-build-properties",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0723abd5-49c0-47a5-a31b-6919c4933249"
      }
    }
  }
}
